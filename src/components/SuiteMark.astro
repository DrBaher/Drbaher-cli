---
// The contract-ops suite mark: a contract page + pipeline-flow relay.
// Transparent background so it blends with the sidebar; two-tone, and
// dark-mode-aware (colors respond to the site's `.dark` class, not the OS).
//   primary = accent-500 (light) / accent-300 (dark)
//   accent  = accent-700 (light) / accent-500 (dark)
interface Props { class?: string; }
const { class: className = 'h-10 w-10 shrink-0' } = Astro.props as Props;
---
<svg viewBox="54 53 406 406" class={className} fill="none" aria-hidden="true">
  <!-- contract page, open outline (primary) -->
  <path d="M 74 108 L 244 108 L 296 160 L 296 404 L 74 404 Z"
        class="stroke-accent-500 dark:stroke-accent-300" stroke-width="22" stroke-linejoin="round"/>
  <path d="M 244 108 L 296 160 L 244 160 Z" class="fill-accent-500 dark:fill-accent-300"/>
  <!-- clause lines (primary) + a filled key-clause bar (accent) -->
  <line x1="108" y1="200" x2="262" y2="200" class="stroke-accent-500 dark:stroke-accent-300" stroke-width="18" stroke-linecap="round"/>
  <rect x="100" y="232" width="126" height="28" rx="14" class="fill-accent-700 dark:fill-accent-500"/>
  <line x1="108" y1="296" x2="262" y2="296" class="stroke-accent-500 dark:stroke-accent-300" stroke-width="18" stroke-linecap="round"/>
  <line x1="108" y1="340" x2="214" y2="340" class="stroke-accent-500 dark:stroke-accent-300" stroke-width="18" stroke-linecap="round"/>
  <!-- pipeline relay: dots flow forward into a chevron (dot2 + chevron = accent) -->
  <circle cx="330" cy="256" r="16" class="fill-accent-500 dark:fill-accent-300"/>
  <circle cx="378" cy="256" r="16" class="fill-accent-700 dark:fill-accent-500"/>
  <path d="M 410 230 L 442 256 L 410 282" class="stroke-accent-700 dark:stroke-accent-500" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
