---
// Animated workflow diagram for the contract-ops suite (nine CLIs).
//   • Tablet / desktop: a centered, symmetric diamond at the pre-signature gate —
//     nda-review (centered) fans out to the two parallel gates (contract-lint +
//     compare) and they merge back into docx2pdf (centered), then sign → manage.
//     The branch and merge are mirror images. Pure SVG SMIL relay.
//   • Phone (< sm): a vertical stack; the two gates render as a side-by-side pair.
//   • Each step is clickable / tappable / keyboard-activatable: it reveals a short
//     description of that CLI in the panel below. Respects prefers-reduced-motion.
const BW = 112, BH = 42;
const W = 546, CX = W / 2;            // 273 — keep max-w literal in sync
const HALF = BW / 2;                  // 56
const TY = [34, 92, 166, 240, 298];   // five tiers (feed · apex · gates · apex · tail)
const D = 64;                         // gate half-spread either side of center
const FRAME_H = TY[4] + BH + 6;       // 346
const cx = (x: number) => x + HALF;
const cy = (y: number) => y + BH / 2;

interface Box { cli: string; verb: string; href: string; blurb: string; x: number; y: number; }
const boxes: Box[] = [
  { cli: 'extract-cli',        verb: 'ingest',  href: '/tools/extract-cli/',        x: 14,        y: TY[0], blurb: "Ingest any contract (.md/.txt/.html/.docx/.pdf) into structured JSON — parties, clauses, dates, governing law — with a confidence and source on every field." },
  { cli: 'template-vault-cli', verb: 'store',   href: '/tools/template-vault-cli/', x: 146,       y: TY[0], blurb: "A git-backed, clause-aware vault for your blank templates — fork, swap clauses with recorded provenance, and pull upstream upgrades." },
  { cli: 'draft-cli',          verb: 'draft',   href: '/tools/draft-cli/',          x: 278,       y: TY[0], blurb: "Fill placeholders in a markdown or .docx template — typed/computed/positional params, a parties registry, multi-document bundles." },
  { cli: 'nda-review-cli',     verb: 'review',  href: '/tools/nda-review-cli/',      x: CX - HALF,        y: TY[1], blurb: "Draft, review, and negotiate NDAs against your house playbook. Deterministic by default; opt-in LLM adjudication." },
  { cli: 'contract-lint-cli',  verb: 'lint',    href: '/tools/contract-lint-cli/',   x: CX - HALF - D,    y: TY[2], blurb: "Lint one contract for internal-consistency defects — leftover placeholders, broken cross-references, defined-term and numbering issues. Gates defects WITHIN one document." },
  { cli: 'compare-cli',        verb: 'compare', href: '/tools/compare-cli/',         x: CX - HALF + D,    y: TY[2], blurb: "Clause-aware drift detection between two contract versions. Gates drift BETWEEN versions, with exit codes CI can branch on." },
  { cli: 'docx2pdf-cli',       verb: 'convert', href: '/tools/docx2pdf-cli/',        x: CX - HALF,        y: TY[3], blurb: "Honest DOCX → PDF conversion with hybrid backends, parallel batches, and font validation." },
  { cli: 'sign-cli',           verb: 'sign',    href: '/tools/sign-cli/',            x: 278,       y: TY[4], blurb: "Fully-offline PAdES e-signature with hash-chained audit events and RFC 3161 timestamps; per-signer tokens gate the human." },
  { cli: 'contract-vault-cli', verb: 'manage',  href: '/tools/contract-vault-cli/',  x: 410,       y: TY[4], blurb: "Register signed contracts, then surface renewals, notice deadlines, recurring obligations, and reminders as a portfolio + an .ics calendar." },
];
const at = (cli: string) => boxes.find((b) => b.cli === cli)!;
const ND = at('nda-review-cli'), LI = at('contract-lint-cli'), CO = at('compare-cli'), DX = at('docx2pdf-cli'), SI = at('sign-cli'), CV = at('contract-vault-cli'), EX = at('extract-cli'), TV = at('template-vault-cli'), DR = at('draft-cli');

interface Arrow { id: string; d: string; begin: number; }
const arrows: Arrow[] = [
  { id: 'f0', d: `M${EX.x + BW + 2} ${cy(EX.y)} L${TV.x - 2} ${cy(TV.y)}`, begin: 0 },        // ingest → store
  { id: 'f1', d: `M${TV.x + BW + 2} ${cy(TV.y)} L${DR.x - 2} ${cy(DR.y)}`, begin: 1 },        // store → draft
  { id: 'f2', d: `M${cx(DR.x)} ${DR.y + BH + 2} L${cx(ND.x)} ${ND.y - 2}`, begin: 2 },         // draft → review
  { id: 'f3', d: `M${cx(ND.x)} ${ND.y + BH + 2} L${cx(LI.x)} ${LI.y - 2}`, begin: 3 },         // review → lint  (branch)
  { id: 'f4', d: `M${cx(ND.x)} ${ND.y + BH + 2} L${cx(CO.x)} ${CO.y - 2}`, begin: 3 },         // review → compare (branch, mirror)
  { id: 'f5', d: `M${cx(LI.x)} ${LI.y + BH + 2} L${cx(DX.x)} ${DX.y - 2}`, begin: 4 },         // lint → convert  (merge)
  { id: 'f6', d: `M${cx(CO.x)} ${CO.y + BH + 2} L${cx(DX.x)} ${DX.y - 2}`, begin: 4 },         // compare → convert (merge, mirror)
  { id: 'f7', d: `M${cx(DX.x)} ${DX.y + BH + 2} L${cx(SI.x)} ${SI.y - 2}`, begin: 5 },         // convert → sign
  { id: 'f8', d: `M${SI.x + BW + 2} ${cy(SI.y)} L${CV.x - 2} ${cy(CV.y)}`, begin: 6 },         // sign → manage
];
const DUR = 16;
---
<div class="not-prose my-8 rounded-lg border border-ink-700/10 bg-white p-5 dark:border-night-300/15 dark:bg-night-600">
  <!-- Tablet / desktop. max-w is literal for Tailwind's scanner; keep in sync with W. -->
  <svg viewBox={`0 0 ${W} ${FRAME_H + 6}`} class="mx-auto hidden h-auto w-full max-w-[546px] sm:block" role="img"
       aria-label="Contract workflow: ingest, store, draft, review; then the flow branches to two parallel pre-signature gates — contract-lint and compare — and merges back into convert, sign, manage. All on your machine. Activate a step for a description.">
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-ink-500 dark:fill-night-200"/>
      </marker>
      <linearGradient id="boxGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fdfcf9"/><stop offset="100%" stop-color="#faf8f3"/>
      </linearGradient>
      <linearGradient id="boxGradDark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1c1916"/><stop offset="100%" stop-color="#15120f"/>
      </linearGradient>
      <radialGradient id="dotGrad">
        <stop offset="0%" stop-color="#3d9a78" stop-opacity="1"/>
        <stop offset="60%" stop-color="#1f7d5d" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#1f7d5d" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect x="6" y="6" width={W - 12} height={FRAME_H} rx="10" fill="none" class="stroke-accent-200 dark:stroke-accent-700/40" stroke-width="1" stroke-dasharray="4 4"/>
    <text x="20" y="24" font-family="Inter, sans-serif" font-size="11" font-weight="600" letter-spacing="0.14em" class="fill-accent-700 dark:fill-accent-300">YOUR MACHINE · NO SAAS · NO TELEMETRY</text>
    <text x={CX} y={TY[2] - 8} font-family="Inter, sans-serif" font-size="9.5" font-style="italic" text-anchor="middle" class="fill-ink-400 dark:fill-night-300">parallel gates — both must pass</text>

    {arrows.map((a) => (
      <path id={a.id} d={a.d} class="stroke-ink-500 dark:stroke-night-200" stroke-width="1.4" fill="none" marker-end="url(#arrow)"/>
    ))}

    {boxes.map((b) => (
      <g class="step-box" role="button" tabindex="0" data-cli={b.cli} data-href={b.href} data-blurb={b.blurb} aria-label={`${b.cli}: ${b.blurb}`}>
        <rect x={b.x} y={b.y} width={BW} height={BH} rx="6" fill="url(#boxGrad)" class="dark:[fill:url(#boxGradDark)] stroke-accent-200 dark:stroke-accent-700/40"/>
        <text x={cx(b.x)} y={b.y + 17} font-family="JetBrains Mono, monospace" font-size="9" text-anchor="middle" font-weight="600" class="fill-accent-700 dark:fill-accent-300">{b.cli}</text>
        <text x={cx(b.x)} y={b.y + 32} font-family="Inter, sans-serif" font-size="12.5" text-anchor="middle" font-weight="600" class="fill-ink-900 dark:fill-night-50">{b.verb}</text>
      </g>
    ))}

    {arrows.map((a) => (
      <circle r="4.5" fill="url(#dotGrad)" class="flow-dot">
        <animateMotion dur={`${DUR}s`} repeatCount="indefinite" begin={`${a.begin}s`} rotate="auto"><mpath href={`#${a.id}`}/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.05;0.95;1" dur={`${DUR}s`} repeatCount="indefinite" begin={`${a.begin}s`}/>
      </circle>
    ))}
  </svg>

  <!-- Phone: vertical stack; the two gates render as a parallel pair. -->
  <div class="flex flex-col sm:hidden">
    {[0, 1, 2, 3].map((i) => (
      <>
        <button type="button" class="wf-card flex w-full items-center justify-between rounded-md border border-accent-200 bg-cream-50 px-3.5 py-2.5 text-left dark:border-accent-700/40 dark:bg-night-700"
                data-cli={boxes[i].cli} data-href={boxes[i].href} data-blurb={boxes[i].blurb} aria-label={`${boxes[i].cli}: ${boxes[i].blurb}`}>
          <span class="flex items-center gap-2.5"><span class="font-mono text-[11px] font-semibold text-ink-400 dark:text-night-300">{i + 1}</span><span class="text-[15px] font-semibold text-ink-900 dark:text-night-50">{boxes[i].verb}</span></span>
          <span class="font-mono text-[11px] text-accent-700 dark:text-accent-300">{boxes[i].cli}</span>
        </button>
        <div class="py-1 text-center text-[13px] leading-none text-accent-500 dark:text-accent-400" aria-hidden="true">↓</div>
      </>
    ))}
    <div class="text-center text-[11px] italic text-ink-400 dark:text-night-300">parallel gates — both must pass</div>
    <div class="mt-1 grid grid-cols-2 gap-2">
      {[4, 5].map((i) => (
        <button type="button" class="wf-card flex flex-col rounded-md border border-accent-200 bg-cream-50 px-3 py-2.5 text-left dark:border-accent-700/40 dark:bg-night-700"
                data-cli={boxes[i].cli} data-href={boxes[i].href} data-blurb={boxes[i].blurb} aria-label={`${boxes[i].cli}: ${boxes[i].blurb}`}>
          <span class="text-[15px] font-semibold text-ink-900 dark:text-night-50">{boxes[i].verb}</span>
          <span class="font-mono text-[10px] text-accent-700 dark:text-accent-300">{boxes[i].cli}</span>
        </button>
      ))}
    </div>
    {[6, 7, 8].map((i) => (
      <>
        <div class="py-1 text-center text-[13px] leading-none text-accent-500 dark:text-accent-400" aria-hidden="true">↓</div>
        <button type="button" class="wf-card flex w-full items-center justify-between rounded-md border border-accent-200 bg-cream-50 px-3.5 py-2.5 text-left dark:border-accent-700/40 dark:bg-night-700"
                data-cli={boxes[i].cli} data-href={boxes[i].href} data-blurb={boxes[i].blurb} aria-label={`${boxes[i].cli}: ${boxes[i].blurb}`}>
          <span class="flex items-center gap-2.5"><span class="font-mono text-[11px] font-semibold text-ink-400 dark:text-night-300">{i}</span><span class="text-[15px] font-semibold text-ink-900 dark:text-night-50">{boxes[i].verb}</span></span>
          <span class="font-mono text-[11px] text-accent-700 dark:text-accent-300">{boxes[i].cli}</span>
        </button>
      </>
    ))}
  </div>

  <!-- Shared detail panel: updated when a step is activated -->
  <div id="wf-detail" class="mt-4 rounded-md border border-ink-700/10 bg-cream-50 px-4 py-3 text-[14px] leading-relaxed text-ink-700 dark:border-night-300/15 dark:bg-night-700 dark:text-night-100" aria-live="polite">
    <span data-wf-hint class="text-ink-500 dark:text-night-200">Tap any step above to see what that CLI does.</span>
    <span data-wf-body hidden>
      <a data-wf-link class="font-mono font-semibold text-accent-700 hover:underline dark:text-accent-300" href="#"></a><span data-wf-blurb></span>
    </span>
  </div>
</div>

<style>
  .step-box { cursor: pointer; }
  .step-box > rect { transition: stroke 0.15s ease, stroke-width 0.15s ease; }
  .step-box:hover > rect,
  .step-box:focus-visible > rect { stroke: #1f7d5d; stroke-width: 2; }
  .step-box[data-selected] > rect { stroke: #1f7d5d; stroke-width: 2.5; }
  .step-box:focus { outline: none; }
  .wf-card { cursor: pointer; transition: border-color 0.15s ease; }
  .wf-card[data-selected] { border-color: #1f7d5d; }

  @media (prefers-reduced-motion: reduce) {
    .flow-dot { display: none; }
  }
</style>

<script>
  const detail = document.getElementById('wf-detail');
  if (detail) {
    const hint = detail.querySelector<HTMLElement>('[data-wf-hint]');
    const body = detail.querySelector<HTMLElement>('[data-wf-body]');
    const link = detail.querySelector<HTMLAnchorElement>('[data-wf-link]');
    const blurbEl = detail.querySelector<HTMLElement>('[data-wf-blurb]');
    const steps = Array.from(document.querySelectorAll<HTMLElement | SVGElement>('[data-cli][data-blurb]'));

    function select(el: HTMLElement | SVGElement) {
      steps.forEach((s) => s.removeAttribute('data-selected'));
      el.setAttribute('data-selected', '');
      const cli = el.getAttribute('data-cli') ?? '';
      if (link) { link.textContent = cli; link.setAttribute('href', el.getAttribute('data-href') ?? '#'); }
      if (blurbEl) blurbEl.textContent = ' — ' + (el.getAttribute('data-blurb') ?? '');
      if (hint) hint.hidden = true;
      if (body) body.hidden = false;
    }

    steps.forEach((el) => {
      el.addEventListener('click', () => select(el));
      el.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') { e.preventDefault(); select(el); }
      });
    });
  }
</script>
