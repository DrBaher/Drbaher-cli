---
// Animated SVG workflow diagram. Eight steps — one per CLI — with traveling
// dots that flow across the arrows in sequence (handoff metaphor). Pure SVG
// SMIL — no JS, works in static export, respects prefers-reduced-motion via CSS.
// Geometry is derived from `steps` so the layout stays correct as the suite grows.
const steps = [
  { cli: 'extract-cli',        verb: 'ingest',  out: 'structured JSON', role: 'any contract' },
  { cli: 'template-vault-cli', verb: 'store',   out: 'versioned template', role: 'your vault' },
  { cli: 'draft-cli',          verb: 'draft',   out: '.md / .docx',     role: 'your template' },
  { cli: 'nda-review-cli',     verb: 'review',  out: 'agreed text',     role: 'your policy' },
  { cli: 'compare-cli',        verb: 'compare', out: 'drift verdict',   role: 'pre-sign gate' },
  { cli: 'docx2pdf-cli',       verb: 'convert', out: '.pdf',            role: 'hybrid backend' },
  { cli: 'sign-cli',           verb: 'sign',    out: 'signed.pdf + audit', role: 'hash-chained' },
  { cli: 'contract-vault-cli', verb: 'manage',  out: 'renewals + deadlines', role: 'signed register' },
];

const X0 = 12;          // left edge of the first box
const BW = 116;         // box width
const BH = 64;          // box height
const GAP = 14;         // gap between boxes
const PITCH = BW + GAP; // 130
const BY = 60;          // box top
const W = X0 * 2 + steps.length * BW + (steps.length - 1) * GAP; // 920 for 7

const boxes = steps.map((s, i) => {
  const x = X0 + i * PITCH;
  return { ...s, x, cx: x + BW / 2 };
});
// One arrow per transition (between consecutive boxes), reused as the dot's motion path.
const arrows = boxes.slice(0, -1).map((b, i) => ({
  id: `flow${i}`,
  x1: b.x + BW + 2,
  x2: b.x + PITCH - 2,
  begin: i * 2,
}));
const DUR = (arrows.length + 1) * 2; // staggered relay over the full cycle
const encW = W - 12;
const lineX2 = X0 + (steps.length - 1) * PITCH + BW;
---
<div class="not-prose my-8 overflow-x-auto rounded-lg border border-ink-700/10 bg-white p-5 dark:border-night-300/15 dark:bg-night-600">
  <!-- max-w must be a literal for Tailwind's scanner; keep in sync with W (8 steps → 1050). -->
  <svg viewBox={`0 0 ${W} 220`} class="mx-auto block h-auto w-full max-w-[1050px]" role="img" aria-label="Contract workflow: ingest any contract, store a template, draft, review, compare for drift, convert to PDF, sign, then manage renewals and deadlines">
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="fill-ink-500 dark:fill-night-200"/>
      </marker>
      <linearGradient id="boxGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#fdfcf9"/>
        <stop offset="100%" stop-color="#faf8f3"/>
      </linearGradient>
      <linearGradient id="boxGradDark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1c1916"/>
        <stop offset="100%" stop-color="#15120f"/>
      </linearGradient>
      <radialGradient id="dotGrad">
        <stop offset="0%" stop-color="#3d9a78" stop-opacity="1"/>
        <stop offset="60%" stop-color="#1f7d5d" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#1f7d5d" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- "your machine" enclosing box -->
    <rect x="6" y="6" width={encW} height="208" rx="10" fill="none" class="stroke-accent-200 dark:stroke-accent-700/40" stroke-width="1" stroke-dasharray="4 4"/>
    <text x="20" y="24" font-family="Inter, sans-serif" font-size="11" font-weight="600" letter-spacing="0.14em" class="fill-accent-700 dark:fill-accent-300">YOUR MACHINE · NO SAAS · NO TELEMETRY</text>

    <!-- Step boxes — same look in light, swapped fill in dark via class -->
    {boxes.map((b) => (
      <g class="step-box">
        <rect x={b.x} y={BY} width={BW} height={BH} rx="6" fill="url(#boxGrad)" class="dark:[fill:url(#boxGradDark)] stroke-accent-200 dark:stroke-accent-700/40"/>
        <text x={b.cx} y="84" font-family="JetBrains Mono, monospace" font-size="10" text-anchor="middle" font-weight="600" class="fill-accent-700 dark:fill-accent-300">{b.cli}</text>
        <text x={b.cx} y="105" font-family="Inter, sans-serif" font-size="13" text-anchor="middle" font-weight="600" class="fill-ink-900 dark:fill-night-50">{b.verb}</text>
      </g>
    ))}

    <!-- Arrow paths (also used as motion paths for the traveling dots) -->
    {arrows.map((a) => (
      <path id={a.id} d={`M${a.x1} 92 L${a.x2} 92`} class="stroke-ink-500 dark:stroke-night-200" stroke-width="1.4" fill="none" marker-end="url(#arrow)"/>
    ))}

    <!-- Traveling dots — one per arrow, staggered begin times so it reads as a relay -->
    {arrows.map((a) => (
      <circle r="4.5" fill="url(#dotGrad)" class="flow-dot">
        <animateMotion dur={`${DUR}s`} repeatCount="indefinite" begin={`${a.begin}s`} rotate="auto">
          <mpath href={`#${a.id}`}/>
        </animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.05;0.95;1" dur={`${DUR}s`} repeatCount="indefinite" begin={`${a.begin}s`}/>
      </circle>
    ))}

    <!-- Output labels under each box -->
    {boxes.map((b) => (
      <text x={b.cx} y="148" font-family="Inter, sans-serif" font-size="11" text-anchor="middle" class="fill-ink-600 dark:fill-night-200">{b.out}</text>
    ))}

    <!-- Bottom strip with role labels -->
    <line x1={X0} y1="170" x2={lineX2} y2="170" class="stroke-accent-100 dark:stroke-accent-700/30" stroke-width="1"/>
    {boxes.map((b) => (
      <text x={b.cx} y="190" font-family="Inter, sans-serif" font-size="11" text-anchor="middle" class="fill-ink-600 dark:fill-night-200">{b.role}</text>
    ))}
  </svg>
</div>

<style>
  /* Pause animation for users who prefer reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .flow-dot { display: none; }
  }
</style>
