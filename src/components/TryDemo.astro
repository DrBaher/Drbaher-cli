---
export interface Props {
  /** Where the live browser demo is hosted. */
  href: string;
  /** Headline for the panel. */
  title?: string;
  /** Body line under the headline. */
  blurb?: string;
  /** Optional CTA label. */
  cta?: string;
}
const {
  href,
  title = 'Try it in your browser',
  blurb = 'A sandboxed read-only demo runs the full flow end-to-end. No install, no signup.',
  cta = 'Open the live demo →',
} = Astro.props as Props;
---
<a
  href={href}
  target="_blank"
  rel="noopener"
  class="not-prose group my-6 flex items-start justify-between gap-4 rounded-lg border border-accent-200 bg-mint-50 p-5 transition-colors hover:border-accent-400 hover:bg-mint-100 dark:border-accent-700/40 dark:bg-accent-900/20 dark:hover:border-accent-400 dark:hover:bg-accent-900/30"
>
  <div>
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-accent-500"></span>
      <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent-700 dark:text-accent-300">Live demo</span>
    </div>
    <h3 class="mt-2 font-serif text-lg font-semibold text-ink-900 dark:text-night-50">{title}</h3>
    <p class="mt-1 text-[14px] text-ink-700 dark:text-night-100">{blurb}</p>
    <span class="mt-2 inline-flex items-center gap-1 text-[13.5px] font-medium text-accent-700 transition-transform group-hover:translate-x-0.5 dark:text-accent-300">{cta}</span>
  </div>
  <svg viewBox="0 0 24 24" class="mt-1 h-6 w-6 flex-shrink-0 text-accent-500 transition-transform group-hover:translate-x-1" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>
