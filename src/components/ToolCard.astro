---
import { fmtCount } from '../data/registry';

export interface Props {
  title: string;
  tagline: string;
  language: string;
  install: string;
  href: string;
  github: string;
  glyph?: string;
  icon?: string;
  version?: string;
  versionSource?: 'npm' | 'pypi' | 'repo' | 'fallback';
  stars?: number;
  weeklyDownloads?: number;
  weeklyDownloadsSource?: 'npm' | 'pypi';
}
const { title, tagline, language, install, href, github, glyph, icon, version, versionSource, stars, weeklyDownloads, weeklyDownloadsSource } = Astro.props as Props;
const dlRegistryLabel = weeklyDownloadsSource === 'pypi' ? 'PyPI' : 'npm';
const versionTitle =
  versionSource === 'npm'  ? 'Live from registry.npmjs.org' :
  versionSource === 'pypi' ? 'Live from pypi.org' :
  versionSource === 'repo' ? 'Read from repo pyproject.toml' :
  'Static fallback (registry was unreachable at build time)';
const starsLabel = fmtCount(stars);
const dlLabel = fmtCount(weeklyDownloads);
---
<div class="not-prose group relative flex h-full flex-col overflow-hidden rounded-lg border border-ink-700/10 bg-white p-6 shadow-[0_1px_2px_rgba(0,0,0,0.03)] transition-all hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-[0_8px_24px_rgba(15,110,81,0.08)] dark:border-night-300/15 dark:bg-night-600 dark:hover:border-accent-400/40 dark:hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)]">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-300/40 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>

  <div class="flex items-start justify-between gap-4">
    <div>
      <a href={href} class="block font-mono text-base font-semibold text-ink-900 hover:text-accent-700 focus-ring dark:text-night-50 dark:hover:text-accent-300">{title}</a>
      <p class="mt-1 text-[14px] leading-relaxed text-ink-700 dark:text-night-100">{tagline}</p>
    </div>
    {icon ? (
      <img src={icon} alt="" width="40" height="40" loading="lazy" decoding="async" class="h-10 w-10 flex-shrink-0 transition-transform group-hover:scale-110" />
    ) : glyph ? (
      <span class="select-none text-2xl text-accent-200 transition-transform group-hover:scale-110 dark:text-accent-400/40" aria-hidden="true">{glyph}</span>
    ) : null}
  </div>

  <div class="mt-auto pt-4">
    <div class="-mx-1 flex flex-nowrap items-center gap-2 overflow-x-auto px-1 pb-1 text-[12px] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <span class="flex-none rounded-md bg-cream-200 px-2 py-0.5 font-medium text-ink-700 dark:bg-night-500 dark:text-night-100">{language}</span>
      {version ? (
        <span title={versionTitle} class="flex-none rounded-md border border-accent-200 bg-accent-50 px-2 py-0.5 font-mono font-medium text-accent-700 dark:border-accent-700/40 dark:bg-accent-900/20 dark:text-accent-300">v{version}</span>
      ) : null}
      {starsLabel ? (
        <a href={github} target="_blank" rel="noopener" title={`${stars} stars on GitHub`} class="inline-flex flex-none items-center gap-1 rounded-md border border-ink-700/15 bg-cream-50 px-2 py-0.5 font-medium text-ink-700 hover:border-accent-300 hover:text-accent-700 dark:border-night-300/20 dark:bg-night-700 dark:text-night-100 dark:hover:text-accent-300">
          <svg viewBox="0 0 16 16" class="h-3 w-3 fill-current" aria-hidden="true"><path d="M8 .25l2.351 4.764 5.257.764-3.804 3.708.898 5.236L8 12.247l-4.702 2.475.898-5.236L.392 5.778l5.257-.764L8 .25z"/></svg>
          {starsLabel}
        </a>
      ) : null}
      {dlLabel ? (
        <span title={`${weeklyDownloads} ${dlRegistryLabel} downloads in the last 7 days`} class="inline-flex flex-none items-center gap-1 rounded-md border border-ink-700/15 bg-cream-50 px-2 py-0.5 text-ink-700 dark:border-night-300/20 dark:bg-night-700 dark:text-night-100">
          <svg viewBox="0 0 16 16" class="h-3 w-3 fill-current" aria-hidden="true"><path d="M8 1v8.59l3.3-3.3 1.41 1.42L8 12.41 3.29 7.71l1.42-1.42L8 9.59V1h0zM2 13h12v2H2v-2z"/></svg>
          {dlLabel}/wk
        </span>
      ) : null}
      <a href={github} class="flex-none text-accent-600 hover:underline dark:text-accent-300" target="_blank" rel="noopener">GitHub ↗</a>
    </div>

    <pre class="mt-3 overflow-x-auto whitespace-nowrap rounded-md bg-ink-900 px-4 py-2.5 text-[12.5px] leading-snug text-cream-50 dark:bg-night-800 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"><code>{install}</code></pre>

    <a href={href} class="mt-3 inline-flex items-center gap-1 text-[13px] font-medium text-accent-600 transition-transform hover:text-accent-700 hover:underline group-hover:translate-x-0.5 dark:text-accent-300 dark:hover:text-accent-200">
      Read more
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
