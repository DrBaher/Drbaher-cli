---
export interface Props {
  title: string;
  tagline: string;
  language: string;
  install: string;
  href: string;
  github: string;
  /** Optional accent emoji-or-symbol shown in the corner */
  glyph?: string;
}
const { title, tagline, language, install, href, github, glyph } = Astro.props as Props;
---
<div class="not-prose group relative rounded-lg border border-ink-700/10 bg-white p-6 shadow-[0_1px_2px_rgba(0,0,0,0.03)] transition-shadow hover:shadow-[0_2px_10px_rgba(0,0,0,0.04)]">
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href={href} class="block font-mono text-base font-semibold text-ink-900 hover:text-accent-700">{title}</a>
      <p class="mt-1 text-[14px] leading-relaxed text-ink-700">{tagline}</p>
    </div>
    {glyph ? <span class="select-none text-2xl text-accent-200" aria-hidden="true">{glyph}</span> : null}
  </div>

  <div class="mt-4 flex items-center gap-2 text-[12px]">
    <span class="rounded-md bg-cream-200 px-2 py-0.5 font-medium text-ink-700">{language}</span>
    <span class="text-ink-400">·</span>
    <a href={github} class="text-accent-600 hover:underline" target="_blank" rel="noopener">GitHub ↗</a>
  </div>

  <pre class="mt-4 overflow-x-auto rounded-md bg-ink-900 px-4 py-2.5 text-[12.5px] leading-snug text-cream-50"><code>{install}</code></pre>

  <a href={href} class="mt-4 inline-flex items-center gap-1 text-[13px] font-medium text-accent-600 hover:text-accent-700 hover:underline">
    Read more
    <span aria-hidden="true">→</span>
  </a>
</div>
