---
import SuiteMark from './SuiteMark.astro';

export interface Props {
  active?: string;
}
const { active } = Astro.props as Props;

const sections = [
  {
    label: 'Start',
    items: [
      { key: 'overview',   href: '/',           label: 'Overview' },
      { key: 'tour',       href: '/tour/',      label: '5-minute tour' },
      { key: 'play',       href: '/play/',      label: 'Playground' },
      { key: 'workflow',   href: '/workflow/',  label: 'The workflow' },
      { key: 'install',    href: '/install/',   label: 'Install' },
      { key: 'principles', href: '/principles/', label: 'Principles' },
    ],
  },
  {
    label: 'Tools',
    items: [
      { key: 'tools/template-vault-cli', href: '/tools/template-vault-cli/', label: 'template-vault-cli' },
      { key: 'tools/draft-cli',      href: '/tools/draft-cli/',      label: 'draft-cli' },
      { key: 'tools/nda-review-cli', href: '/tools/nda-review-cli/', label: 'nda-review-cli' },
      { key: 'tools/compare-cli',    href: '/tools/compare-cli/',    label: 'compare-cli' },
      { key: 'tools/docx2pdf-cli',   href: '/tools/docx2pdf-cli/',   label: 'docx2pdf-cli' },
      { key: 'tools/sign-cli',       href: '/tools/sign-cli/',       label: 'sign-cli' },
    ],
  },
  {
    label: 'More',
    items: [
      { key: 'use-cases', href: '/use-cases/', label: 'Use cases' },
      { key: 'compare',   href: '/compare/',   label: 'Compare vs SaaS' },
      { key: 'mcp',       href: '/mcp/',       label: 'MCP server' },
      { key: 'built-for-agents', href: '/built-for-agents/', label: 'Built for agents' },
      { key: 'changelog', href: '/changelog/', label: 'Changelog' },
    ],
  },
  {
    label: 'External',
    items: [
      { key: '_gh', href: 'https://github.com/DrBaher', label: 'All repos on GitHub', external: true },
    ],
  },
] as const;
---

<!-- Mobile top bar -->
<div class="flex items-center justify-between border-b border-ink-700/10 bg-cream-50 px-5 py-3 lg:hidden dark:border-night-300/15 dark:bg-night-700">
  <a href="/" class="flex items-center gap-2 font-serif font-semibold text-ink-900 dark:text-night-50">
    <SuiteMark class="h-10 w-10 shrink-0" />
    <span class="flex flex-col leading-[1.1]">
      <span class="text-lg">contract-ops</span>
      <span class="text-sm font-medium text-ink-500 dark:text-night-200">CLI suite</span>
    </span>
  </a>
  <div class="flex items-center gap-2">
    <button data-search-trigger aria-label="Open search" class="theme-toggle">
      <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <button data-theme-toggle aria-label="Toggle dark mode" class="theme-toggle">
      <svg viewBox="0 0 16 16" class="h-4 w-4 dark:hidden" aria-hidden="true"><path d="M8 1v2M8 13v2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M1 8h2M13 8h2M3.05 12.95l1.41-1.41M11.54 4.46l1.41-1.41" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
      <svg viewBox="0 0 16 16" class="hidden h-4 w-4 dark:block" aria-hidden="true"><path d="M13.5 10.4A5.5 5.5 0 1 1 5.6 2.5a4.5 4.5 0 0 0 7.9 7.9z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/></svg>
    </button>
    <button id="nav-toggle" aria-label="Open navigation" class="pill">
      <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true">
        <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
      </svg>
      Menu
    </button>
  </div>
</div>

<!-- Sidebar (slide-out on mobile, fixed on desktop) -->
<aside
  id="sidebar"
  class="hidden flex-col border-r border-ink-700/10 bg-cream-100 lg:sticky lg:top-0 lg:flex lg:h-screen lg:overflow-y-auto nice-scroll dark:border-night-300/15 dark:bg-night-600"
>
  <div class="flex items-center justify-between p-5">
    <a href="/" class="flex items-center gap-2.5 font-serif font-semibold text-ink-900 dark:text-night-50">
      <SuiteMark class="h-10 w-10 shrink-0" />
      <span class="flex flex-col leading-[1.1]">
        <span class="text-lg">contract-ops</span>
        <span class="text-sm font-medium text-ink-500 dark:text-night-200">CLI suite</span>
      </span>
    </a>
    <div class="flex items-center gap-1">
      <button data-theme-toggle aria-label="Toggle dark mode" class="theme-toggle hidden lg:inline-flex">
        <svg viewBox="0 0 16 16" class="h-4 w-4 dark:hidden" aria-hidden="true"><path d="M8 1v2M8 13v2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M1 8h2M13 8h2M3.05 12.95l1.41-1.41M11.54 4.46l1.41-1.41" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4" fill="none"/></svg>
        <svg viewBox="0 0 16 16" class="hidden h-4 w-4 dark:block" aria-hidden="true"><path d="M13.5 10.4A5.5 5.5 0 1 1 5.6 2.5a4.5 4.5 0 0 0 7.9 7.9z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/></svg>
      </button>
      <button id="nav-close" aria-label="Close navigation" class="pill lg:hidden">
        <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <button
    data-search-trigger
    class="mx-3 mb-2 flex items-center justify-between gap-2 rounded-md border border-ink-700/15 bg-cream-50 px-3 py-2 text-[13px] text-ink-600 transition-colors hover:border-accent-300 hover:bg-cream-200 hover:text-ink-900 dark:border-night-300/20 dark:bg-night-700 dark:text-night-200 dark:hover:bg-night-500 dark:hover:text-night-50"
    aria-label="Open search palette"
  >
    <span class="flex items-center gap-2">
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" aria-hidden="true">
        <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Search
    </span>
    <kbd class="rounded bg-cream-200 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink-700 dark:bg-night-500 dark:text-night-100">⌘K</kbd>
  </button>

  <nav class="px-2 pb-8">
    {sections.map(section => (
      <>
        <div class="nav-section">{section.label}</div>
        <ul>
          {section.items.map(item => {
            const isActive = active === item.key;
            const external = (item as any).external;
            return (
              <li>
                <a
                  href={item.href}
                  class={`nav-link ${isActive ? 'active' : ''}`}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                >
                  {item.label}{external ? ' ↗' : ''}
                </a>
              </li>
            );
          })}
        </ul>
      </>
    ))}
  </nav>
</aside>
