---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/Callout.astro';
import Playground from '../components/Playground.astro';
import TryDemo from '../components/TryDemo.astro';
---
<BaseLayout
  title="Playground"
  active="play"
  description="Run all six contract-ops CLIs in your browser — one sandbox, real templates and a house policy book, no install, nothing stored."
>
  <p class="eyebrow">Playground</p>
  <h1>Run the CLIs in your browser.</h1>

  <p class="text-lg text-ink-700 dark:text-night-100">
    Try any of the six tools on <strong>your own input</strong> — no install, nothing stored. All six
    run in the sandbox below on a realistic corpus; <a href="/tools/sign-cli/">sign</a> also has a
    richer guided web-demo under it.
  </p>

  <Callout label="How it works">
    Each run executes the real CLI server-side with strict limits — short timeout, rate-limited,
    a stripped environment, ephemeral storage (your input is never kept). To see the tools chained
    end to end, take the <a href="/tour/">5-minute tour</a>.
  </Callout>

  <h2 data-reveal>All six CLIs, one sandbox</h2>
  <p data-reveal>Six tabs plus a guided full-pipeline: fill real templates, gate clause drift, convert a <code class="chip">.docx</code>, explore a seeded multi-category vault, review an NDA against a house policy book, and sign offline.</p>
  <Playground height="660px" title="contract-ops playground" />

  <h2 data-reveal>sign — guided web-demo</h2>
  <p data-reveal>A read-only walkthrough of the offline send → sign → verify → receipt flow.</p>
  <TryDemo
    href="https://sign-cli-demo-production.up.railway.app/web-demo/"
    title="See sign-cli sending a real PDF"
    blurb="Read-only browser demo of the full send → sign → verify → receipt flow. Sandboxes reset every few hours."
  />
</BaseLayout>
